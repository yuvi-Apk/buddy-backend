{
  "permissions": {
    "allow": [
      "Bash(pnpm run lint *)",
      "Bash(pnpm run lint)",
      "Bash(pnpm run typecheck)",
      "Bash(pnpm run test *)",
      "Bash(pnpm run test)",
      "Bash(pnpm run format)",
      "Bash(pnpm run build)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test *)",
      "Bash(pnpm test)",
      "Bash(pnpm format)",
      "Bash(pnpm build)",
      "Bash(pnpm exec prisma generate)",
      "Bash(pnpm exec prisma format)",
      "Bash(pnpm exec prisma migrate dev *)",
      "Bash(pnpm exec prisma migrate deploy)",
      "Bash(pnpm exec prisma migrate status)",
      "Bash(docker compose up *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose ps)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git log)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Read(./.env.sample)",
      "Edit(./.env.sample)",
      "Read(./.env.test)",
      "Edit(./.env.test)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Read(./.env.local)",
      "Edit(./.env.local)",
      "Read(./.env.production*)",
      "Edit(./.env.production*)",
      "Read(./.env.development*)",
      "Edit(./.env.development*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git reset --hard)",
      "Bash(pnpm exec prisma migrate reset *)",
      "Bash(pnpm exec prisma migrate reset)",
      "Bash(pnpm exec prisma db push *)",
      "Bash(pnpm exec prisma db push)",
      "Bash(npx prisma migrate reset *)",
      "Bash(npx prisma db push *)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/format.mjs",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
