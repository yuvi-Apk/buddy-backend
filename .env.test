# Used only by `pnpm test`. Local, non-secret values. Never put real secrets here.

NODE_ENV=test
PORT=4001
LOG_LEVEL=silent
TRUST_PROXY=0
CORS_ORIGINS=http://localhost:3000

# Separate database (created by docker/postgres-init.sql) and separate Redis db index
DATABASE_URL=postgresql://buddy:buddy_local@localhost:5432/buddy_test
REDIS_URL=redis://localhost:6379/1

ADMIN_ACCESS_TOKEN_SECRET=test-only-admin-access-token-secret-0000000000
USER_ACCESS_TOKEN_SECRET=test-only-user-access-token-secret-00000000000
OTP_HMAC_SECRET=test-only-otp-hmac-secret-000000000000000000000

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

STORAGE_DRIVER=local

SEED_SUPER_ADMIN_EMAIL=super@buddy.test
SEED_SUPER_ADMIN_PASSWORD=test-only-password-123
