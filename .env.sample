# Copy this file to .env and fill in the values.
# This list is checked against src/config/env.ts by tests/guardrails/env-sample.test.ts.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Number of reverse proxies in front of the API (0 when none)
TRUST_PROXY=0

# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:3000

# Matches docker-compose.yml
DATABASE_URL=postgresql://buddy:buddy_local@localhost:5432/buddy
REDIS_URL=redis://localhost:6379/0

# Three different random values, at least 32 characters each.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_ACCESS_TOKEN_SECRET=
USER_ACCESS_TOKEN_SECRET=
OTP_HMAC_SECRET=

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

STORAGE_DRIVER=local

# First super admin, created by `pnpm db:seed`. Password: at least 12 characters.
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
